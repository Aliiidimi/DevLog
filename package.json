{
  "name": "devlog",
  "productName": "DevLog",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "app": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:win": "tsc -b && vite build && electron-builder --win --dir",
    "build:installer": "tsc -b && vite build && electron-builder --win -p always",
    "build:mac": "tsc -b && vite build && electron-builder --mac",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.devlog.app",
    "productName": "DevLog",
    "publish": {
      "provider": "github",
      "owner": "Aliiidimi",
      "repo": "DevLog",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "dev-app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "electron-updater": "^6.8.9",
    "firebase": "^12.19.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
